{
  "name": "rebt-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "check": "npm run typecheck && npm test",
    "test": "node --test \"test/*.test.ts\"",
    "mock": "node mock/server.ts",
    "dev:mock": "BOE_TARGET=http://localhost:8787 BOE_PREFIX= vite"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "@types/node": "26.6.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "7.0.2",
    "vite": "5.4.11"
  }
}
